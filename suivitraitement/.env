# Configuration CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5000,http://localhost:3000
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
APP_CORS_ALLOWED_HEADERS=*
APP_CORS_ALLOW_CREDENTIALS=true

# Configuration Spring
SERVER_PORT=8002
SPRING_PROFILES_ACTIVE=dev

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres_suivitraitement:5432/suivitraitement_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=admin1234

# Services externes
PROFILES_BASE_URL=http://profile_service:3000/api/profiles
PROFILES_API_TOKEN=