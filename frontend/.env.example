# Frontend environment variables for HealthTrack services
# Copy this file to `.env.local` or `.env.development` and adjust as needed.

# Profile Service base URL (no trailing slash)
VITE_PROFILES=http://localhost:3000

# Devices Service base URL
VITE_DEVICES=http://localhost:8000

# Appointments Service base URL
VITE_APPOINTMENTS=http://localhost:8082

# Treatments Service base URL
VITE_TREATMENTS=http://localhost:8002

# Notes:
# - Vite will inject these into `import.meta.env.*`.
# - The frontend expects Profile API under `${VITE_PROFILES}/api/profiles`.
# - Ensure the Profile service is running and CORS is enabled.